PORT=4000
# 允許的前端來源，可用逗號分隔多個（本機、GitHub Pages）
CLIENT_URL=http://localhost:5173,https://apple19890708.github.io
MONGO_URI=mongodb+srv://<db_user>:<db_password>@tarot.obc9phl.mongodb.net/tarot-divination?retryWrites=true&w=majority&appName=tarot
MONGO_DB_NAME=tarot-divination

# AI 口語解讀，使用 OpenRouter（未設定時前台改顯示規則分析）
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# 解讀前的推理深度，low／medium／high，不設就是 high
# OPENROUTER_REASONING_EFFORT=high
OPENROUTER_API_KEY=

# 登入用的 JWT 簽章密鑰，必填（沒設定伺服器不會啟動）
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 瀏覽器推播（選填，沒設定就不提供）。產生金鑰：npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY 會給前端（不是秘密）；VAPID_PRIVATE_KEY 是秘密；VAPID_SUBJECT 填聯絡信箱，例如 mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 外部排程呼叫 /api/cron/market 用的密鑰（選填，沒設定時排程端點關閉）。產生方式同 JWT_SECRET
# GitHub Actions 的 repository secret 也要設同一個值
CRON_SECRET=

# 忘記密碼寄信（Gmail API，v17 規格 I）與 Google 登入。都沒設定時兩個功能回 503，一般登入不受影響
# GOOGLE_CLIENT_ID 同時給 Google 登入驗證用（前端的 VITE_GOOGLE_CLIENT_ID 要填同一個）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 寄件人：授權 refresh token 的那個 Gmail
GMAIL_SENDER=
# 前端網址（含 GitHub Pages 的子路徑），重設密碼信的連結用；沒設定時用 CLIENT_URL 的第一個
APP_URL=
