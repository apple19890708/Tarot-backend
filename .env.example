PORT=4000
# 允許的前端來源，可用逗號分隔多個（本機、GitHub Pages）
CLIENT_URL=http://localhost:5173,https://apple19890708.github.io
MONGO_URI=mongodb+srv://<db_user>:<db_password>@tarot.obc9phl.mongodb.net/tarot-divination?retryWrites=true&w=majority&appName=tarot
MONGO_DB_NAME=tarot-divination

# AI 口語解讀，使用 OpenRouter（未設定時前台改顯示規則分析）
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# 解讀前的推理深度，low／medium／high，不設就是 high
# OPENROUTER_REASONING_EFFORT=high
OPENROUTER_API_KEY=

# 登入用的 JWT 簽章密鑰，必填（沒設定伺服器不會啟動）
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
